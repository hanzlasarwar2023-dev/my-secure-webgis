# ===========================================================================
#  PU WebGIS - Environment variables
#  Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database --------------------------------------------------------------
# Cloud PostgreSQL connection string (Render / Supabase / Neon / AWS RDS).
# Example: postgres://user:password@host:5432/dbname?sslmode=require
# Leave EMPTY to fall back to the local DB_* values below.
DATABASE_URL=

# TLS for the database connection. Set to false ONLY for a local Postgres
# without certificates. Cloud databases should keep this true.
DB_SSL=true

# Local database (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME="Project 1"
DB_USER=postgres
DB_PASSWORD=

# --- Security --------------------------------------------------------------
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# It MUST be >= 32 characters and MUST be identical on every deployed instance.
JWT_SECRET=
JWT_TTL=7d
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8
SESSION_DAYS=7

# Extra origins allowed to call the API (comma separated).
# Same-origin requests need no entry here.
ALLOWED_ORIGINS=

# How many reverse-proxy hops to trust for client IP + HTTPS detection.
# Render = 1. Use 0 only when running with no proxy at all.
TRUST_PROXY_HOPS=1

# --- App -------------------------------------------------------------------
# Code a new user must enter to register. Leave EMPTY to allow open signup.
JOIN_CODE=PU2026

# --- Rate limits (per IP) ---------------------------------------------------
RATE_LIMIT_API_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
